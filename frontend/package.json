{
  "name": "weather-aware-truck-routing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:stories": "vitest run --project stories",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1",
    "css:types": "node scripts/css-types.mjs",
    "pretypecheck": "npm run css:types"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "maplibre-gl": "6.4.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "4.1.11",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "jsdom": "30.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "storybook": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@storybook/addon-vitest": "10.6.1",
    "@storybook/addon-a11y": "10.6.1",
    "eslint-plugin-storybook": "10.6.1",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-testing-library": "7.16.2",
    "globals": "17.13.0",
    "stylelint": "file:vendor/stylelint",
    "stylelint-config-standard": "40.0.0",
    "stylelint-declaration-strict-value": "1.12.1",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
